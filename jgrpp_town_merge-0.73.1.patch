+/**
+ * Turn a single command line argument into a town.
+ * The argument is either a plain number (a town ID) or a (partial) town name.
+ * An exact name match wins; a partial name is only accepted when it matches
+ * exactly one town. Otherwise the possible matches are printed, so the user can
+ * either refine the name or use an ID.
+ * @param arg The command line argument to resolve.
+ * @return The town, or nullptr when the argument does not resolve to exactly one town.
+ */
+static Town *ResolveTownArg(std::string_view arg)
+{
+	if (arg.empty()) return nullptr;
+
+	/* All digits: treat it as a town ID. */
+	const bool is_number = std::all_of(arg.begin(), arg.end(), [](char c) { return c >= '0' && c <= '9'; });
+	if (is_number) {
+		const TownID id = ParseType<TownID>(arg).value_or(TownID::Invalid());
+		if (Town::IsValidID(id)) return Town::Get(id);
+		IConsolePrint(CC_ERROR, "没有 ID 为 {} 的城镇。", arg);
+		return nullptr;
+	}
+
+	/* Otherwise look the name up, preferring an exact match. */
+	std::vector<Town *> exact_match;
+	std::vector<Town *> partial_match;
+	for (Town *t : Town::Iterate()) {
+		const std::string_view name = t->GetCachedName();
+		if (StrEqualsIgnoreCase(name, arg)) {
+			exact_match.push_back(t);
+		} else if (StrContainsIgnoreCase(name, arg)) {
+			partial_match.push_back(t);
+		}
+	}
+
+	if (exact_match.size() == 1) return exact_match[0];
+
+	const std::vector<Town *> &candidates = exact_match.empty() ? partial_match : exact_match;
+	if (candidates.empty()) {
+		IConsolePrint(CC_ERROR, "没有名字里包含「{}」的城镇。可以先用 'list_towns {}' 找找。", arg, arg);
+		return nullptr;
+	}
+	if (candidates.size() == 1) return candidates[0];
+
+	IConsolePrint(CC_ERROR, "「{}」匹配到 {} 座城镇，请写得更精确一些，或者直接给城镇 ID：", arg, candidates.size());
+	PrintTownCandidates(candidates, 20);
+	return nullptr;
+}
+
+static bool ConListTowns(std::span<std::string_view> argv)
+{
+	if (argv.size() > 2) {
+		IConsolePrint(CC_HELP, "Debug: List towns.  Usage: 'list_towns [name filter]'");
+		return true;
+	}
+
+	const std::string_view filter = (argv.size() == 2) ? argv[1] : std::string_view{};
+
+	std::vector<Town *> towns;
+	for (Town *t : Town::Iterate()) {
+		if (!filter.empty() && !StrContainsIgnoreCase(t->GetCachedName(), filter)) continue;
+		towns.push_back(t);
+	}
+	std::sort(towns.begin(), towns.end(), [](const Town *a, const Town *b) {
+		return StrCompareIgnoreCase(a->GetCachedName(), b->GetCachedName()) < 0;
+	});
+
+	if (filter.empty()) {
+		IConsolePrint(CC_INFO, "共 {} 座城镇（按名称排序）：", towns.size());
+	} else {
+		IConsolePrint(CC_INFO, "名字里包含「{}」的城镇有 {} 座：", filter, towns.size());
+	}
+
+	constexpr size_t MAX_PRINT = 60;
+	PrintTownCandidates(towns, MAX_PRINT);
+	IConsolePrint(CC_HELP, "提示：merge_towns <被并入的城镇> <保留的城镇> —— 名字或 ID 都行，多个源城用逗号隔开。");
+	return true;
+}
+
+static bool ConMergeTowns(std::span<std::string_view> argv)
+{
+	if (argv.size() != 3) {
+		IConsolePrint(CC_HELP, "Debug: Merge one or more towns into another.  Usage: 'merge_towns <source> <destination>'");
+		IConsolePrint(CC_HELP, "  <source> / <destination>: town name or town ID; several sources can be separated by commas");
+		IConsolePrint(CC_HELP, "  A partial name is accepted as long as it matches exactly one town.  Put double quotes around names containing spaces.");
+		IConsolePrint(CC_HELP, "  Examples: merge_towns \"丹霞凹,东桥洞\" 珠三角     merge_towns 12 45");
+		return true;
+	}
+
+	if (_game_mode != GameMode::Normal && _game_mode != GameMode::Editor) {
+		IConsolePrint(CC_ERROR, "This command is only available in a game or in the scenario editor.");
+		return true;
+	}
+
+	Town *destination = ResolveTownArg(argv[2]);
+	if (destination == nullptr) return true;
+	const TownID destination_id = destination->index;
+
+	auto trim = [](std::string_view s) {
+		while (!s.empty() && (s.front() == ' ' || s.front() == '\t')) s.remove_prefix(1);
+		while (!s.empty() && (s.back() == ' ' || s.back() == '\t')) s.remove_suffix(1);
+		return s;
+	};
+
+	size_t merged = 0;
+	size_t failed = 0;
+	const std::string_view list = argv[1];
+	size_t offset = 0;
+	while (offset <= list.size()) {
+		const size_t comma = list.find(',', offset);
+		const size_t length = (comma == std::string_view::npos) ? std::string_view::npos : comma - offset;
+		const std::string_view arg = trim(list.substr(offset, length));
+
+		if (!arg.empty()) {
+			Town *source = ResolveTownArg(arg);
+			if (source == nullptr) {
+				failed++;
+			} else if (source->index == destination_id) {
+				IConsolePrint(CC_WARNING, "「{}」就是目标城镇本身，跳过。", source->GetCachedName());
+			} else {
+				/* Capture everything we need before the merge deletes the source town. */
+				const std::string source_name{source->GetCachedName()};
+				const uint32_t source_population = source->cache.population;
+				const uint16_t source_id = source->index.base();
+
+				if (MergeTowns(source->index, destination_id)) {
+					destination = Town::Get(destination_id);
+					IConsolePrint(CC_WARNING, "已把「{}」(id {}, 人口 {}) 并入「{}」；现在人口 {}。",
+							source_name, source_id, source_population,
+							destination->GetCachedName(), destination->cache.population);
+					merged++;
+				} else {
+					IConsolePrint(CC_ERROR, "合并「{}」(id {}) 失败。", source_name, source_id);
+					failed++;
+				}
+			}
+		}
+
+		if (comma == std::string_view::npos) break;
+		offset = comma + 1;
+	}
+
+	if (merged > 0) {
+		IConsolePrint(CC_WARNING, "完成：成功合并 {} 座，失败 {} 座。", merged, failed);
+		IConsolePrint(CC_INFO, "此操作不可撤销 —— 建议立刻「另存为」一个新档，然后重新载入验证。");
+		ShowTownViewWindow(destination_id);
+	} else {
+		IConsolePrint(CC_ERROR, "没有任何城镇被合并（失败 {} 座）。", failed);
+	}
 
 	return true;
 }
