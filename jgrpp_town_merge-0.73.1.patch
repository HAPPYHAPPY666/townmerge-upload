+/** Print a short list of towns, used to show the user what matched. */
+static void PrintTownCandidates(const std::vector<Town *> &towns, size_t max_count)
+{
+	const size_t shown = std::min(towns.size(), max_count);
+	for (size_t i = 0; i < shown; i++) {
+		IConsolePrint(CC_INFO, "    {}  {}  (人口 {})",
+				towns[i]->index.base(), towns[i]->GetCachedName(), towns[i]->cache.population);
+	}
+	if (towns.size() > shown) {
+		IConsolePrint(CC_INFO, "    ...（还有 {} 座没列出）", towns.size() - shown);
+	}
+}
