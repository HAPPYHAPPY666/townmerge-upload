+static bool ConListTowns(std::span<std::string_view> argv)
+{
+	if (argv.size() != 1) {
+		IConsolePrint(CC_HELP, "Debug: List all towns with their IDs.  Usage: 'list_towns'");
+		return true;
+	}
+
+	std::vector<const Town *> towns;
+	for (const Town *t : Town::Iterate()) towns.push_back(t);
+	std::sort(towns.begin(), towns.end(), [](const Town *a, const Town *b) {
+		return a->cache.population > b->cache.population;
+	});
+
+	for (const Town *t : towns) {
+		IConsolePrint(CC_INFO, "{}: {} (population {}, houses {}, city {})",
+				t->index.base(), t->GetCachedName(), t->cache.population, t->cache.num_houses, t->larger_town ? "yes" : "no");
+	}
+
+	return true;
+}
+
+static bool ConMergeTowns(std::span<std::string_view> argv)
+{
+	if (argv.size() != 3) {
+		IConsolePrint(CC_HELP, "Debug: Merge one town into another.  Usage: 'merge_towns <source-town-id> <destination-town-id>'");
+		IConsolePrint(CC_HELP, "The source town is absorbed by the destination town and is then removed. Use 'list_towns' to find the town IDs.");
+		IConsolePrint(CC_HELP, "This modifies the savegame in place and is not reversible: make a backup first.");
+		return true;
+	}
+
+	if (_game_mode != GameMode::Normal && _game_mode != GameMode::Editor) {
+		IConsolePrint(CC_ERROR, "This command is only available in a game or in the scenario editor.");
+		return true;
+	}
+
+	TownID source_id = ParseType<TownID>(argv[1]).value_or(TownID::Invalid());
+	TownID destination_id = ParseType<TownID>(argv[2]).value_or(TownID::Invalid());
+	if (!Town::IsValidID(source_id) || !Town::IsValidID(destination_id)) {
+		IConsolePrint(CC_ERROR, "Invalid town ID. Use 'list_towns' to see the available towns.");
+		return true;
+	}
+	if (source_id == destination_id) {
+		IConsolePrint(CC_ERROR, "The source town and the destination town must be different.");
+		return true;
+	}
+
+	/* Capture the names before merging: the source town is deleted by the merge. */
+	const std::string source_name{Town::Get(source_id)->GetCachedName()};
+	const std::string destination_name{Town::Get(destination_id)->GetCachedName()};
+
+	if (MergeTowns(source_id, destination_id)) {
+		IConsolePrint(CC_WARNING, "Merged town '{}' into town '{}'.", source_name, destination_name);
+	} else {
+		IConsolePrint(CC_ERROR, "Failed to merge the towns.");
+	}
 
 	return true;
 }
