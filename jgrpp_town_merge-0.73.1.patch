 /**
+ * Merge one town into another.
+ *
+ * Everything the source town owns is re-assigned to the destination town:
+ * the town ownership stored on house and road tiles, stations, waypoints,
+ * depots, industries and objects, plus the cached statistics (population,
+ * house counts, company ratings, statues, ...). Afterwards the source town
+ * is deleted.
+ *
+ * Bridges and tunnels do not store an owner of their own - their ownership is
+ * derived from the adjacent road tiles - so re-assigning those tiles is all
+ * that is needed for them as well.
+ *
+ * This is a debug/utility operation and not a networked command. Only use it
+ * in single player, and always keep a backup of the savegame: anything that
+ * cannot be transferred is dropped (subsidies, cargo packets that originate
+ * from the merged town, NewGRF persistent storage of the merged town).
+ *
+ * @param source_id The town to merge away. It is deleted by this function.
+ * @param destination_id The town that absorbs @p source_id.
+ * @return True on success, false if the given town IDs are not usable.
+ */
+bool MergeTowns(TownID source_id, TownID destination_id)
+{
+	if (source_id == destination_id) return false;
+
+	Town *src = Town::GetIfValid(source_id);
+	Town *dst = Town::GetIfValid(destination_id);
+	if (src == nullptr || dst == nullptr) return false;
+
+	/* 1. Re-assign the town ownership that is stored on the map tiles
+	 *    (houses and town-owned roads). Player-owned road tiles only carry a
+	 *    cached nearest town, which is refreshed by Town::PostDestructor(). */
+	for (TileIndex tile(0); tile < Map::Size(); ++tile) {
+		switch (GetTileType(tile)) {
+			case TileType::House:
+				if (GetTownIndex(tile) == src->index) SetTownIndex(tile, dst->index);
+				break;
+
+			case TileType::Road:
+				if (HasTownOwnedRoad(tile) && GetTownIndex(tile) == src->index) SetTownIndex(tile, dst->index);
+				break;
+
+			default:
+				break;
+		}
+	}
+
+	/* 2. Re-assign stations and waypoints. Their default name is resolved from
+	 *    the town at draw time, so only the cached name has to be dropped. */
+	for (Station *st : Station::Iterate()) {
+		if (st->town != src) continue;
+		st->town = dst;
+		st->cached_name.clear();
+		st->UpdateVirtCoord();
+	}
+	for (Waypoint *wp : Waypoint::Iterate()) {
+		if (wp->town != src) continue;
+		wp->town = dst;
+		wp->cached_name.clear();
+		wp->UpdateVirtCoord();
+	}
+
+	/* 3. Re-assign depots. Their default name is generated on the fly. */
+	for (Depot *d : Depot::Iterate()) {
+		if (d->town == src) d->town = dst;
+	}
+
+	/* 4. Re-assign industries and objects (statues, lighthouses, ...). */
+	for (Industry *i : Industry::Iterate()) {
+		if (i->town == src) i->town = dst;
+	}
+	for (Object *o : Object::Iterate()) {
+		if (o->town == src) o->town = dst;
+	}
+
+	/* 5. A Game Script can create a goal whose destination is a town; that
+	 *    destination is stored as a plain town ID, so it has to be re-pointed
+	 *    before the source town is removed. */
+	for (Goal *g : Goal::Iterate()) {
+		if (g->type == GT_TOWN && g->dst == source_id.base()) g->dst = destination_id.base();
+	}
+
+	/* 6. Merge the cached statistics of the source town into the destination. */
+	auto merge_counts = [](auto &dest, const auto &src_counts) {
+		if (dest.size() < src_counts.size()) dest.resize(src_counts.size(), 0);
+		for (size_t i = 0; i < src_counts.size(); i++) dest[i] += src_counts[i];
+	};
+	merge_counts(dst->cache.building_counts.id_count, src->cache.building_counts.id_count);
+	merge_counts(dst->cache.building_counts.class_count, src->cache.building_counts.class_count);
+
+	dst->cache.num_houses += src->cache.num_houses;
+	dst->cache.population += src->cache.population;
+	dst->church_count += src->church_count;
+	dst->stadium_count += src->stadium_count;
+	dst->larger_town |= src->larger_town;
+
+	/* A company keeps the worse of the two ratings, so that merging cannot be
+	 * abused to launder a bad reputation. */
+	for (CompanyID c : src->have_ratings.IterateSetBits()) {
+		if (dst->have_ratings.Test(c)) {
+			dst->ratings[c] = std::min<int16_t>(dst->ratings[c], src->ratings[c]);
+			dst->unwanted[c] = std::max<uint8_t>(dst->unwanted[c], src->unwanted[c]);
+		} else {
+			dst->have_ratings.Set(c);
+			dst->ratings[c] = src->ratings[c];
+			dst->unwanted[c] = src->unwanted[c];
+		}
+	}
+	for (CompanyID c : src->statues.IterateSetBits()) dst->statues.Set(c);
+	if (src->exclusive_counter > dst->exclusive_counter) {
+		dst->exclusivity = src->exclusivity;
+		dst->exclusive_counter = src->exclusive_counter;
+	}
+
+	/* 7. Recalculate the data that is derived from the merged statistics. */
+	UpdateTownRadius(dst);
+	UpdateTownMaxPass(dst);
+	dst->UpdateVirtCoord();
+	dst->UpdateLabel();
+
+	/* 8. The list of nearby stations of a town is only rebuilt from station
+	 *    catchments when a station or a town is (re)built, and the towns it is
+	 *    derived from are looked up through the house tiles. Now that the
+	 *    houses changed owner, the nearby station lists of the destination town
+	 *    are out of date, and the town growth rate (CountActiveStations) would
+	 *    be computed from an incomplete list. Rebuild them. */
+	Station::RecomputeCatchmentForAll();
+
+	/* 9. Drop the source town. Its destructor removes the remaining references
+	 *    (subsidies, cargo packets, NewGRF persistent storage) and, in debug
+	 *    builds, asserts that no tile/industry/object still points at it. */
+	_town_kdtree.Remove(src->index);
+	_town_local_authority_kdtree.Remove(src->index);
+	if (_viewport_sign_kdtree_valid && src->cache.sign.kdtree_valid()) _viewport_sign_kdtree.Remove(ViewportSignKdtreeItem::MakeTown(src->index));
+	delete src;
+
+	SetWindowDirty(WindowClass::TownView, dst->index);
+	MarkWholeScreenDirty();
+	RebuildTownKdtree();
+
+	return true;
+}
