+/**
+ * Get the town that is waiting for another town to be merged into it.
+ * A pending merge is abandoned as soon as the town window that started it is gone.
+ * @param source Receives the town that will absorb the clicked town.
+ * @return True when a merge is pending.
+ */
+bool GetTownMergePickSource(TownID &source)
+{
+	if (_merge_town_pick_source == TownID::Invalid() || !Town::IsValidID(_merge_town_pick_source)) {
+		_merge_town_pick_source = TownID::Invalid();
+		return false;
+	}
+	if (FindWindowById(WindowClass::TownView, _merge_town_pick_source) == nullptr) {
+		_merge_town_pick_source = TownID::Invalid();
+		return false;
+	}
+	source = _merge_town_pick_source;
+	return true;
+}
+
+/**
+ * Merge the given town into the town that is waiting to absorb one.
+ * This is called when the player clicks a town while the merge tool is active.
+ * @param absorbed_id The town that was clicked.
+ * @return True when a pending merge was handled.
+ */
+bool HandleTownMergePick(TownID absorbed_id)
+{
+	TownID destination_id;
+	if (!GetTownMergePickSource(destination_id)) return false;
+
+	if (absorbed_id == destination_id || !Town::IsValidID(absorbed_id)) {
+		ShowErrorMessage(GetEncodedString(STR_TOWN_VIEW_MERGE_TOWN_SAME), {}, WarningLevel::Info);
+		return true;
+	}
+
+	ClearTownMergePick();
+	ResetObjectToPlace();
+
+	if (MergeTowns(absorbed_id, destination_id)) {
+		ShowTownViewWindow(destination_id);
+	}
+	return true;
+}
